{
  "$defs": {
    "text": {"type": "string", "minLength": 1},
    "location": {"type": "string", "pattern": "^(?:(?:/|\\$WORK_ROOT/)[^\\x00\\r\\n]+)(?![\\s\\S])"},
    "digest": {"type": "string", "pattern": "^(?:[0-9a-f]{64})(?![\\s\\S])"},
    "owner": {"type": "string", "pattern": "^(?:(?:task:[a-z][a-z0-9]*-[0-9a-f]{6}|session:[^\\s]+))(?![\\s\\S])"},
    "trigger": {"type": "string", "pattern": "^(?:(?!none$)[^\\x00\\r\\n]+)(?![\\s\\S])"}
  },
  "anyOf": [
